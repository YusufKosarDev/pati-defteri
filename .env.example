# Convex backend
# `npx convex dev` ilk çalıştığında .env.local'i otomatik doldurur.
VITE_CONVEX_URL=

# Web Push (VAPID public key). Convex deployment env'ine PRIVATE eşi
# `npx convex env set VAPID_PRIVATE_KEY ...` ile yazılır.
VITE_VAPID_PUBLIC_KEY=

# Resend e-posta API anahtarı (sadece deploy ortamı için)
RESEND_API_KEY=
