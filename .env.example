# Convex backend
# `npx convex dev` ilk çalıştığında .env.local'i otomatik doldurur.
VITE_CONVEX_URL=

# Web Push (VAPID public key). Convex deployment env'ine PRIVATE eşi
# `npx convex env set VAPID_PRIVATE_KEY ...` ile yazılır.
VITE_VAPID_PUBLIC_KEY=

# Resend e-posta gönderimi — Convex deployment env'ine yazılır (frontend'e gitmez):
#   npx convex env set RESEND_API_KEY re_xxx
#   npx convex env set RESEND_FROM "PatiDefteri <bildirim@senin-domainin.com>"
# RESEND_FROM verilmezse Resend test göndericisi kullanılır; bu sadece hesap
# sahibinin kendi adresine teslim eder, production için doğrulanmış domain şart.

# Sentry error tracking (opsiyonel, production'da hata izlemek için)
# Boş bırakılırsa Sentry devre dışı, hatalar sadece console'a yazılır.
VITE_SENTRY_DSN=
